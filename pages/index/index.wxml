<view class="app" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
  <view class="slide light {{current === 0 ? 'active' : ''}} {{current > 0 ? 'prev' : ''}}">
    <view class="bg-carousel">
      <image wx:for="{{heroPhotos}}" wx:key="*this" wx:for-index="photoIndex" class="bg-photo {{heroIndex === photoIndex ? 'active' : ''}}" src="{{item}}" mode="aspectFit" />
    </view>
    <view class="veil"></view>
    <view class="content">
      <view class="top-actions reveal">
        <text class="chip">JULY 18, 2026</text>
        <button class="icon-button {{musicOn ? 'music-on' : ''}}" type="button" aria-label="音乐开关" bindtap="toggleMusic">
          <view class="music-note"></view>
        </button>
      </view>

      <view class="hero-copy">
        <text class="hero-names reveal">黄洪逸 ＆ 庞璐</text>
        <text class="lead light-lead reveal">我们生命旅程中的亲朋挚友：</text>
        <text class="lead light-lead reveal">有生之年，喜相逢。</text>
        <text class="lead light-lead reveal">佳期已定，婚礼见！</text>
        <view class="button-row three reveal">
          <button class="button primary hero-secondary-button" type="button" data-index="1" bindtap="goTo">查看地点</button>
          <button class="button hero-secondary-button" type="button" data-index="4" bindtap="goTo">周边攻略</button>
        </view>
      </view>
    </view>
  </view>

  <view class="slide cream wedding-info {{current === 1 ? 'active' : ''}} {{current > 1 ? 'prev' : ''}}">
    <image class="cream-bg" src="https://wedding-1307100970.cos.ap-guangzhou.myqcloud.com/bg-soft.jpg" mode="aspectFill" />
    <view class="cream-wash"></view>
    <view class="content">
      <view>
        <text class="kicker reveal">Invitation</text>
        <text class="section-title reveal">婚礼信息</text>
        <view class="couple reveal">
          <view class="person">
            <text class="person-name">黄洪逸</text>
            <text class="person-role">新郎</text>
          </view>
          <text class="amp">＆</text>
          <view class="person">
            <text class="person-name">庞璐</text>
            <text class="person-role">新娘</text>
          </view>
        </view>
      </view>

      <view class="info-stack reveal">
        <view class="detail-box">
          <text>婚礼时间</text>
          <text class="detail-strong">2026 年 7 月 18 日 18:00</text>
        </view>

        <view class="countdown">
          <view class="timebox"><text class="time-number">{{countdown.days}}</text><text>天</text></view>
          <view class="timebox"><text class="time-number">{{countdown.hours}}</text><text>小时</text></view>
          <view class="timebox"><text class="time-number">{{countdown.minutes}}</text><text>分钟</text></view>
          <view class="timebox"><text class="time-number">{{countdown.seconds}}</text><text>秒</text></view>
        </view>

        <view class="venue-box">
          <image class="venue-photo" src="https://wedding-1307100970.cos.ap-guangzhou.myqcloud.com/hotel.jpg" mode="aspectFill" />
          <text class="venue-title">福建省漳州市龙海区钻石大酒店 · 水晶厅</text>
          <text class="venue-desc">2026 年 7 月 18 日 19:00。建议提前 30 分钟到达，现场以酒店指引为准。</text>
          <view class="map-row">
            <button class="map-primary" type="button" bindtap="openVenueLocation">打开地图</button>
            <button type="button" data-query="福建省漳州市龙海区钻石大酒店" bindtap="copyMapKeyword">复制地址</button>
          </view>
        </view>

        <view class="schedule-list">
          <view class="schedule-item">
            <text class="schedule-time">18:30</text>
            <view><text class="schedule-title">宾客入场</text><text class="schedule-desc">签到、合影、入席</text></view>
          </view>
          <view class="schedule-item">
            <text class="schedule-time">19:00</text>
            <view><text class="schedule-title">婚礼仪式</text><text class="schedule-desc">证婚、誓言与合影</text></view>
          </view>
          <view class="schedule-item">
            <text class="schedule-time">19:30</text>
            <view><text class="schedule-title">晚宴开始</text><text class="schedule-desc">敬酒、用餐、亲友致意</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="slide cream gallery-only {{current === 2 ? 'active' : ''}} {{current > 2 ? 'prev' : ''}}">
    <image class="cream-bg" src="https://wedding-1307100970.cos.ap-guangzhou.myqcloud.com/bg-soft.jpg" mode="aspectFill" />
    <view class="cream-wash"></view>
    <view class="content gallery-content">
      <view class="gallery-title reveal">
        <text class="kicker">MOMENT</text>
        <text class="section-title">时刻</text>
      </view>
      <view class="gallery reveal">
        <view wx:for="{{galleryPhotos}}" wx:key="*this" wx:for-index="photoIndex" class="gallery-frame {{galleryIndex === photoIndex ? 'active' : ''}}">
          <image src="{{item}}" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <view class="slide light thanks {{current === 3 ? 'active' : ''}} {{current > 3 ? 'prev' : ''}}">
    <image class="photo-bg" src="https://wedding-1307100970.cos.ap-guangzhou.myqcloud.com/place2.jpg" mode="aspectFill" />
    <view class="veil"></view>
    <view class="content">
      <text class="chip reveal">See You Soon</text>
      <view class="thanks-copy">
        <text class="title thanks-title reveal">【公历 7月18日 · 福建龙海】</text>
        <text class="lead light-lead reveal">我们如此有缘</text>
        <text class="lead light-lead reveal">在生命中的不同经纬相识</text>
        <text class="lead light-lead reveal">共度一段珍贵岁月</text>
        <text class="lead light-lead reveal">如今，一场集齐回忆与幸福的团建即将开始</text>
        <text class="lead light-lead reveal">期待重逢</text>
        <text class="footer-date reveal">黄洪逸 ＆ 庞璐</text>
      </view>
    </view>
  </view>

  <view class="slide cream travel {{current === 4 ? 'active' : ''}} {{current > 4 ? 'prev' : ''}}">
    <image class="cream-bg" src="https://wedding-1307100970.cos.ap-guangzhou.myqcloud.com/bg-soft.jpg" mode="aspectFill" />
    <view class="cream-wash"></view>
    <view class="content travel-content">
      <view class="travel-head">
        <text class="kicker reveal">Travel Guide</text>
        <text class="section-title reveal">周边逛吃推荐</text>
        <text class="lead reveal">以婚礼酒店为中心，我们整理了适合顺路逛吃的目的地清单，供您参考。</text>
      </view>

      <view class="guide-panel reveal" mark:guidePanel="true">
        <view class="search-box">
          <scroll-view class="filter-row" scroll-x enhanced show-scrollbar="{{false}}">
            <button wx:for="{{guideCategories}}" wx:key="*this" class="filter-chip {{item === activeCategory ? 'active' : ''}}" type="button" data-category="{{item}}" bindtap="setCategory">{{item}}</button>
          </scroll-view>
        </view>

        <scroll-view class="guide-grid" scroll-y enhanced enable-flex="{{true}}" show-scrollbar="{{false}}" bindscroll="onGuideScroll" bindscrolltoupper="onGuideScrollUpper" bindscrolltolower="onGuideScrollLower">
          <view wx:if="{{!filteredGuideItems.length}}" class="empty-guide">没有找到匹配内容，换个关键词试试。</view>
          <view wx:for="{{filteredGuideItems}}" wx:key="name" class="guide-card">
            <image wx:if="{{item.image}}" class="guide-photo" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
            <view class="guide-meta">
              <text class="guide-pill">{{item.category}}</text>
              <text class="guide-pill distance">{{item.distance}}</text>
              <text class="guide-pill">{{item.time}}</text>
            </view>
            <text class="guide-name">{{item.name}}</text>
            <text class="guide-desc">{{item.desc}}</text>
            <view class="guide-meta">
              <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="guide-pill">{{tag}}</text>
            </view>
            <view wx:if="{{item.hasNavigation && item.location}}" class="guide-actions">
              <button type="button" data-latitude="{{item.location.latitude}}" data-longitude="{{item.location.longitude}}" data-name="{{item.location.name}}" data-address="{{item.location.address}}" bindtap="openGuideLocation">导航</button>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>


  <view class="pager">
    <button wx:for="{{pageDots}}" wx:key="*this" wx:for-index="dotIndex" class="dot {{current === dotIndex ? 'active' : ''}}" type="button" data-index="{{dotIndex}}" bindtap="goTo"></button>
  </view>
</view>
