.app {
  position: relative;
  width: 100vw;
  max-width: 430px;
  height: 100vh;
  margin: 0 auto;
  overflow: hidden;
  background: #fff9ef;
  box-shadow: 0 24px 80px rgba(50, 39, 31, 0.18);
}

.slide {
  position: absolute;
  inset: 0;
  min-height: 100%;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateY(26px) scale(0.985);
  transition: opacity 0.62s ease, transform 0.62s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.slide.active {
  z-index: 2;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}

.slide.prev {
  transform: translateY(-24px) scale(0.985);
}

.bg-carousel,
.photo-bg,
.cream-bg {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
}

.bg-carousel {
  background: #1d1814;
}

.bg-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity 1.2s ease, transform 6s ease;
}

.bg-photo.active {
  opacity: 1;
  transform: scale(1);
}

.veil {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(180deg, rgba(29, 24, 20, 0.08), rgba(29, 24, 20, 0.34) 44%, rgba(29, 24, 20, 0.82));
}

.cream {
  background: #fff9ef;
}

.cream-wash {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: rgba(255, 249, 239, 0.75);
}

.content {
  position: relative;
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  justify-content: space-between;
  gap: 18px;
  box-sizing: border-box;
  padding: 44px 22px 26px;
}

.wedding-info .content {
  justify-content: space-evenly;
  gap: 20px;
  padding-top: 54px;
  padding-bottom: 38px;
}

.light {
  color: #fffaf2;
}

.top-actions {
  margin-top: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chip {
  display: inline-flex;
  width: fit-content;
  min-height: 30px;
  align-items: center;
  border: 1px solid currentColor;
  border-radius: 999px;
  padding: 0 10px;
  background: rgba(255, 255, 255, 0.14);
  font-size: 11px;
  font-weight: 800;
}

.icon-button {
  display: flex;
  flex: 0 0 30px;
  width: 30px;
  height: 30px;
  min-width: 30px;
  min-height: 30px;
  max-width: 30px;
  max-height: 30px;
  align-items: center;
  justify-content: center;
  border: 1px solid currentColor;
  border-radius: 50%;
  padding: 0;
  background: rgba(255, 255, 255, 0.14);
  color: #fffaf2;
  line-height: 1;
  overflow: visible;
}

.icon-button.music-on {
  background: #fffaf2;
  color: #2d2925;
}

.music-note {
  position: relative;
  width: 10px;
  height: 13px;
  border-left: 2px solid currentColor;
  border-top: 2px solid currentColor;
  transform: translateY(-1px) skewY(-8deg);
  transform-origin: center;
}

.music-on .music-note {
  animation: music-spin 3.6s linear infinite;
}

@keyframes music-spin {
  from {
    transform: translateY(-1px) skewY(-8deg) rotate(0deg);
  }

  to {
    transform: translateY(-1px) skewY(-8deg) rotate(360deg);
  }
}

.music-note::after {
  content: "";
  position: absolute;
  left: -6px;
  bottom: -2px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.hero-copy,
.thanks-copy {
  display: flex;
  flex-direction: column;
}

.hero-copy {
  align-items: center;
  text-align: center;
  padding-bottom: 50px;
}

.thanks-copy {
  align-items: center;
  text-align: center;
}

.hero-names {
  display: block;
  margin-bottom: 10px;
  font-family: "STSong", "Songti SC", serif;
  font-size: 40px;
  font-weight: 400;
  line-height: 0.98;
}

.title {
  display: block;
  margin-bottom: 14px;
  font-family: "STSong", "Songti SC", serif;
  font-size: 30px;
  font-weight: 400;
  line-height: 1.08;
}

.thanks-title {
  font-size: 24px;
  line-height: 1.18;
}

.section-title {
  display: block;
  margin-top: 4px;
  color: #2d2925;
  font-family: Georgia, "Times New Roman", "STSong", serif;
  font-size: 34px;
  font-weight: 400;
  line-height: 1.04;
}

.kicker {
  display: block;
  margin-bottom: 8px;
  color: #b9975c;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.lead {
  display: block;
  margin-top: 4px;
  color: #756a61;
  font-size: 15px;
  line-height: 1.58;
}

.light-lead {
  color: rgba(255, 250, 242, 0.86);
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  align-self: stretch;
  box-sizing: border-box;
  margin: 40px 12px 0;
  width: auto;
  min-width: 0;
}

.button-row.three {
  padding: 0;
}

.button-row.three .hero-main-button {
  flex: 0 0 100%;
  width: 100%;
  margin-bottom: 8px;
}

.button-row.three .hero-secondary-button {
  flex: 0 0 calc((100% - 8px) / 2);
  width: calc((100% - 8px) / 2);
}

.button-row.three .hero-secondary-button + .hero-secondary-button {
  margin-left: 8px;
}

.button {
  display: flex;
  width: auto;
  max-width: 100%;
  min-width: 0;
  min-height: 38px;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border: 1px solid currentColor;
  border-radius: 999px;
  padding: 0 10px;
  background: rgba(255, 255, 255, 0.14);
  color: inherit;
  font-size: 12px;
  font-weight: 800;
  text-align: center;
}

.button::after {
  border: 0;
}

.button.primary {
  border-color: #b87972;
  background: #b87972;
  color: #fffaf2;
}

.couple {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 10px;
  align-items: center;
  margin-top: 12px;
  margin-bottom: 0;
}

.person {
  min-height: 72px;
  border: 1px solid rgba(57, 47, 38, 0.16);
  border-radius: 8px;
  padding: 12px 10px;
  background: rgba(255, 250, 242, 0.72);
  text-align: center;
}

.person-name {
  display: block;
  color: #2d2925;
  font-size: 18px;
  font-weight: 800;
}

.person-role {
  display: block;
  margin-top: 6px;
  color: #756a61;
  font-size: 12px;
}

.amp {
  color: #b9975c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24px;
}

.info-stack {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-top: -10px;
}

.wedding-info .info-stack {
  gap: 14px;
  margin-top: 0;
}

.detail-box,
.venue-box,
.schedule-list,
.guide-panel,
.route-view,
.guide-card {
  border: 1px solid rgba(57, 47, 38, 0.16);
  border-radius: 8px;
  background: rgba(255, 250, 242, 0.82);
}

.detail-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 12px;
  color: #756a61;
  font-size: 12px;
}

.detail-strong {
  color: #2d2925;
  font-size: 13px;
  font-weight: 800;
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px 6px;
}

.timebox {
  display: flex;
  min-height: 52px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(57, 47, 38, 0.16);
  border-radius: 8px;
  background: #fffaf2;
  color: #756a61;
  font-size: 11px;
}

.time-number {
  display: block;
  color: #b87972;
  font-size: 19px;
  font-weight: 900;
  line-height: 1.1;
}

.venue-box {
  overflow: hidden;
  padding: 10px;
}

.venue-photo {
  width: 100%;
  height: 110px;
  border-radius: 6px;
}

.venue-title {
  display: block;
  margin-top: 9px;
  color: #2d2925;
  font-size: 15px;
  font-weight: 900;
  line-height: 1.35;
}

.venue-desc {
  display: block;
  margin-top: 6px;
  color: #756a61;
  font-size: 12px;
  line-height: 1.5;
}

.map-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8px;
  margin: 10px 0;
}

.map-row button,
.guide-actions button,
.route-link {
  display: flex;
  min-width: 0;
  box-sizing: border-box;
  height: 34px;
  min-height: 34px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(57, 47, 38, 0.16);
  border-radius: 999px;
  background: #fffaf2;
  color: #2d2925;
  font-size: 11px;
  font-weight: 800;
  line-height: 34px;
  padding: 0 8px;
  text-align: center;
  white-space: nowrap;
}

.map-row button,
.route-link {
  width: 100%;
}

.map-row .map-primary {
  border-color: #b87972;
  background: #b87972;
  color: #fffaf2;
}

.schedule-list {
  overflow: hidden;
}

.schedule-item {
  display: grid;
  grid-template-columns: 50px 1fr;
  gap: 10px;
  padding: 13px 12px;
  border-top: 1px solid rgba(57, 47, 38, 0.12);
}

.schedule-item:first-child {
  border-top: 0;
}

.schedule-time {
  color: #b87972;
  font-size: 14px;
  font-weight: 900;
}

.schedule-title,
.schedule-desc {
  display: block;
}

.schedule-title {
  color: #2d2925;
  font-size: 13px;
  font-weight: 900;
}

.schedule-desc {
  margin-top: 3px;
  color: #756a61;
  font-size: 11px;
}

.travel-content {
  gap: 10px;
  justify-content: flex-start;
  min-height: 0;
  overflow: hidden;
  padding-bottom: 20px;
}

.travel-head {
  flex: none;
}

.travel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.home-shortcut {
  display: flex;
  width: 88px;
  height: 32px;
  min-height: 32px;
  flex: 0 0 88px;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border: 1px solid rgba(57, 47, 38, 0.18);
  border-radius: 999px;
  padding: 0;
  background: rgba(255, 250, 242, 0.86);
  color: #2d2925;
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 8px 20px rgba(50, 39, 31, 0.12);
}

.home-shortcut::after {
  border: 0;
}

.guide-panel {
  display: flex;
  height: 0;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  gap: 9px;
  overflow: hidden;
  padding: 10px;
}

.filter-row,
.route-tabs {
  display: flex;
  width: 100%;
  white-space: nowrap;
}

.route-tabs {
  margin-top: 8px;
}

.filter-chip,
.route-tab {
  display: inline-flex;
  width: auto;
  min-width: 0;
  flex-shrink: 0;
  max-width: 118px;
  height: 30px;
  min-height: 30px;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  border: 1px solid rgba(57, 47, 38, 0.16);
  border-radius: 999px;
  padding: 0 12px;
  background: #fffaf2;
  color: #756a61;
  font-size: 11px;
  font-weight: 800;
  line-height: 30px;
  white-space: nowrap;
}

.filter-chip.active,
.route-tab.active {
  margin-right: 8px;
  border-color: #87907a;
  background: #87907a;
  color: #fffaf2;
}

.route-view {
  flex: none;
  padding: 8px;
}

.route-detail {
  padding-top: 8px;
}

.route-title {
  display: block;
  color: #2d2925;
  font-size: 14px;
  font-weight: 900;
}

.route-line {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 7px;
}

.route-point {
  border-radius: 999px;
  padding: 4px 7px;
  background: rgba(185, 151, 92, 0.16);
  color: #2d2925;
  font-size: 11px;
}

.route-desc {
  display: block;
  margin: 7px 0;
  color: #756a61;
  font-size: 12px;
  line-height: 1.55;
}

.guide-grid {
  height: 0;
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  padding-bottom: 10px;
  -webkit-overflow-scrolling: touch;
}

.empty-guide {
  padding: 24px 8px;
  color: #756a61;
  font-size: 13px;
  text-align: center;
}

.guide-card {
  margin-bottom: 8px;
  padding: 10px;
}

.guide-photo {
  display: block;
  width: 100%;
  height: 210px;
  margin-bottom: 9px;
  border-radius: 6px;
  background: rgba(135, 144, 122, 0.12);
}

.guide-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.guide-pill {
  border-radius: 999px;
  padding: 4px 8px;
  background: rgba(135, 144, 122, 0.14);
  color: #756a61;
  font-size: 10px;
  font-weight: 800;
}

.guide-pill.distance {
  background: rgba(185, 151, 92, 0.16);
  color: #9a753d;
}

.guide-name {
  display: block;
  margin-top: 8px;
  color: #2d2925;
  font-size: 14px;
  font-weight: 900;
  line-height: 1.35;
}

.guide-desc {
  display: block;
  margin: 6px 0 8px;
  color: #756a61;
  font-size: 12px;
  line-height: 1.62;
}

.guide-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;
  width: 100%;
  margin-top: 8px;
}

.guide-actions button {
  width: 100%;
}

.gallery-content {
  justify-content: center;
}

.gallery-title {
  position: absolute;
  top: 44px;
  right: 22px;
  z-index: 3;
  text-align: right;
  color: #fffaf2;
  text-shadow: 0 2px 14px rgba(24, 19, 16, 0.34);
}

.gallery-title .kicker {
  margin-bottom: 6px;
  color: rgba(255, 250, 242, 0.86);
}

.gallery-title .section-title {
  color: #fffaf2;
  font-size: 34px;
}

.gallery {
  position: relative;
  width: 100%;
  height: 68vh;
  overflow: hidden;
  border-radius: 8px;
  background: #f0e4d4;
}

.gallery-frame {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: scale(1);
  transition: opacity 0.9s ease, transform 4s ease;
}

.gallery-frame.active {
  opacity: 1;
  transform: scale(1);
}

.gallery-frame image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}

.footer-date {
  display: block;
  margin-top: 22px;
  color: #b9975c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 17px;
  font-weight: 800;
}

.pager {
  position: absolute;
  right: 12px;
  top: 50%;
  z-index: 5;
  display: flex;
  flex-direction: column;
  gap: 11px;
  transform: translateY(-50%);
}

.dot {
  display: block;
  width: 11px;
  height: 11px;
  min-width: 11px;
  min-height: 11px;
  max-width: 11px;
  max-height: 11px;
  margin: 0;
  padding: 0;
  border: 1px solid rgba(255, 250, 242, 0.82);
  border-radius: 50%;
  background: rgba(45, 41, 37, 0.46);
  box-shadow: 0 2px 8px rgba(24, 19, 16, 0.25);
  font-size: 0;
  line-height: 0;
}

.light .dot,
.dot.active {
  background: #fffaf2;
}

.dot.active {
  border-color: rgba(255, 250, 242, 0.96);
  background: #b9975c;
  transform: scale(1.28);
}

.reveal {
  animation: rise 0.72s ease both;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-height: 720px) {
  .content {
    padding-top: 34px;
    padding-bottom: 18px;
  }

  .wedding-info .content {
    gap: 14px;
    padding-top: 38px;
    padding-bottom: 22px;
  }

  .wedding-info .info-stack {
    gap: 9px;
  }

  .hero-names {
    font-size: 36px;
  }

  .section-title {
    font-size: 30px;
  }

  .thanks-title {
    font-size: 21px;
  }

  .venue-photo {
    height: 86px;
  }

  .schedule-item {
    padding-top: 9px;
    padding-bottom: 9px;
  }

  .gallery {
    height: 64vh;
  }
}
